{
  "name": "helpdesk",
  "private": true,
  "description": "AI Powered Ticket Management System — monorepo (Laravel API + Vue SPA)",
  "scripts": {
    "up": "docker compose up",
    "up:build": "docker compose up --build",
    "down": "docker compose down",
    "logs": "docker compose logs -f",
    "api": "docker compose exec api sh",
    "web": "docker compose exec web sh",
    "db": "docker compose exec db psql -U helpdesk -d helpdesk",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "e2e:down": "bash scripts/e2e/down.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.13.2"
  }
}
